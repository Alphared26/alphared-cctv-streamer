[Unit]
Description=Alphared RTSP NVR & YouTube Live Streamer
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/mnt/hdd/alphared-streamer
ExecStart=/usr/local/bin/alphared-streamer -port 8085 -data /mnt/hdd/alphared-streamer/cameras.json
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
